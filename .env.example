# App
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-this-with-a-long-random-string
ADMIN_EMAIL=admin@example.com

# MariaDB. Leave DB_HOST blank to use temporary in-memory demo mode.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=boisterous
DB_USER=boisterous_user
DB_PASSWORD=ChangeThisPassword123!

# Optional Google OAuth (Google Cloud Console -> OAuth client, Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Optional Twilio Verify for real SMS OTP
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Optional SMTP for real transactional emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Boisterous Store <orders@example.com>"

# Optional OpenAI API key for live AI stylist
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
